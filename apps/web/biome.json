{
  "extends": "//",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": ["dist/**", "build/**", ".next/**", "node_modules/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "error" 
      },
      "suspicious": {
        "noArrayIndexKey": "warn", 
        "noExplicitAny": "warn"    
      },
      "style": {
        "useSelfClosingElements": "error", 
        "useTemplate": "error"    
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",       
      "jsxQuoteStyle": "double",
      "semicolons": "always",     
      "trailingCommas": "all"
    }
  }
}
